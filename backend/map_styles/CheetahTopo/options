# The levels specification for this style
#
# Cheetah Pro watches render only bits 22 and 20 for short routes;
# the bits-24 level is never displayed, so it is dropped.
# Bits 18/16 remain for long-route fit-to-screen previews.
levels = 0:22, 1:20, 2:18, 3:16

overview-levels = 2:18, 3:16 
